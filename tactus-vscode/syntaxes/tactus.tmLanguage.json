{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tactus",
  "scopeName": "source.tactus",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#tactus-dsl-keywords"
    },
    {
      "include": "#field-builders"
    },
    {
      "include": "#require-statements"
    },
    {
      "include": "#lua-keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.tactus",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "comment.line.double-dash.tactus",
          "match": "--(?!\\[\\[).*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.multiline.tactus",
          "begin": "\\[\\[",
          "end": "\\]\\]",
          "patterns": [
            {
              "name": "constant.character.escape.tactus",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.tactus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tactus",
              "match": "\\\\."
            },
            {
              "name": "constant.other.placeholder.tactus",
              "match": "\\{[^}]+\\}"
            }
          ]
        },
        {
          "name": "string.quoted.single.tactus",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.tactus",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "tactus-dsl-keywords": {
      "patterns": [
        {
          "name": "keyword.control.tactus",
          "match": "\\b(Agent|Model|Procedure|Task|IncludeTasks|Tool|Toolset|Prompt|Context|Hitl|Specification|Specifications|Step|Evaluation|Evaluations|Human|Log|State|File|Session|Retry)\\b"
        },
        {
          "name": "entity.name.function.tactus",
          "match": "\\b(name|version|description|input|output|default_provider|default_model|return_prompt|error_prompt|status_prompt|async|max_depth|max_turns)\\b"
        }
      ]
    },
    "field-builders": {
      "patterns": [
        {
          "name": "support.function.tactus",
          "match": "\\bfield\\s*\\.\\s*(string|number|boolean|array|object|any)\\b"
        }
      ]
    },
    "require-statements": {
      "patterns": [
        {
          "name": "meta.function-call.require.tactus",
          "begin": "\\b(require)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "support.function.require.tactus"
            },
            "2": {
              "name": "punctuation.definition.arguments.begin.tactus"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.arguments.end.tactus"
            }
          },
          "patterns": [
            {
              "include": "#strings"
            }
          ]
        }
      ]
    },
    "lua-keywords": {
      "patterns": [
        {
          "name": "keyword.control.lua",
          "match": "\\b(break|do|else|elseif|end|for|function|goto|if|in|local|repeat|return|then|until|while)\\b"
        },
        {
          "name": "keyword.operator.lua",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.lua",
          "match": "\\b(nil|true|false)\\b"
        },
        {
          "name": "variable.language.self.lua",
          "match": "\\bself\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.lua",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.lua",
          "match": "\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lua",
          "match": "\\b\\d+([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.lua",
          "match": "[+\\-*/%^#]"
        },
        {
          "name": "keyword.operator.comparison.lua",
          "match": "==|~=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.lua",
          "match": "="
        },
        {
          "name": "keyword.operator.concatenation.lua",
          "match": "\\.\\."
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.lua",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"
        },
        {
          "name": "entity.name.function.lua",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\{)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.lua",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
